+// CubeXCraft: Iris declares `in ivec3 iris_Entity` but feeds it as GL_UNSIGNED_SHORT through glVertexAttribIPointer.
+// Desktop drivers accept the sign mismatch; ANGLE on Metal (iOS) cannot read ushort3 into int3, so with a shader pack
+// entities, the hand and text were not drawn at all. Declare it unsigned and convert every use back to ivec3.
+static void cxc_fix_iris_entity_attrib(std::string& src) {
+    if (src.find("iris_Entity") == std::string::npos) return;
+    static const std::regex decl(R"(\bin\s+ivec3\s+iris_Entity\s*;)");
+    if (!std::regex_search(src, decl)) return;
+    src = std::regex_replace(src, decl, "in uvec3 CXC_IRIS_ENTITY_DECL;");
+    static const std::regex use(R"(\biris_Entity\b)");
+    src = std::regex_replace(src, use, "ivec3(iris_Entity)");
+    size_t pos = src.find("CXC_IRIS_ENTITY_DECL");
+    src.replace(pos, strlen("CXC_IRIS_ENTITY_DECL"), "iris_Entity");
+}
+
 void glShaderSource(GLuint shader, GLsizei count, const GLchar *const* string, const GLint *length) {    
     LOG()
     shaderInfo.id = 0;
